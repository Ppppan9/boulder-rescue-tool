    "test:h5": "node test/h5-export.mjs",
    "test:cursor": "node test/cursor-test.mjs"
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.49.1",
    "three": "^0.170.0"
